;;; Cadastro v3: 18 templates do DWG BocasBueiro_Cadastro_Conferencia atualizado.
;;; Comando recomendado: BOCASCADASTRO. BSTC/BDTC/BTTC; diametros 1.00 a 3.00 m.
;;; ==========================================================================
;;; BocasBueiroDNIT.lsp
;;; Blocos dinamicos de bocas de bueiros tubulares de concreto
;;; Base: DNIT IPR-736 Emenda 3 - desenhos 6.4(a) BNAR, 6.5(a) BNAA,
;;;       6.6(a) BEAA 15, 6.7(a) BEAA 30, 6.8(a) BEAA 45
;;; Diametros 1,00 / 1,20 / 1,50 = tabelas do album
;;; Diametros 2,00 / 2,50 / 3,00 = EXTRAPOLADOS (sem respaldo do album DNIT)
;;;
;;; Comandos:
;;;   BOCASTESTE  - cria so o bloco BOCA_BNAR_PLANTA (rode primeiro p/ testar)
;;;   BOCASDNIT   - cria os 10 blocos dinamicos (5 tipos x planta/frontal)
;;;   BOCASBASE   - cria apenas os blocos estaticos (sem bloco dinamico)
;;;
;;; Rode num desenho NOVO e vazio (biblioteca). Unidade lida de INSUNITS:
;;;   6=metro (padrao Civil 3D), 5=centimetro, 4=milimetro, 0=assume metro.
;;;
;;; Insercao - PLANTA : no eixo do feixe de tubos, na face da testa onde o
;;;   bueiro chega. Bueiro ao longo de +Y, alas para -Y. Esconsas ja saem
;;;   com a testa girada; para esconsidade do outro lado use ESPELHAR.
;;; Insercao - FRONTAL: centro do feixe, na geratriz inferior (topo da soleira).
;;; ==========================================================================
(vl-load-com)

(defun bc:esc ( / u)
  (setq u (getvar "INSUNITS"))
  (cond ((= u 6) 0.01) ((= u 5) 1.0) ((= u 4) 10.0) (T 0.01)))

(defun bc:camada (nome cor lt)
  (if (not (tblsearch "LAYER" nome))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
                   '(100 . "AcDbLayerTableRecord") (cons 2 nome) '(70 . 0)
                   (cons 62 cor) (cons 6 lt)))))

(defun bc:tipolinha (lt)
  (if (not (tblsearch "LTYPE" lt))
    (vl-catch-all-apply 'vla-load
      (list (vla-get-linetypes (vla-get-activedocument (vlax-get-acad-object)))
            lt "acadiso.lin")))
  (if (tblsearch "LTYPE" lt) lt "Continuous"))

(defun bc:camadas ()
  (bc:camada "BOCA-CONCRETO" 7 "Continuous")
  (bc:camada "BOCA-SOLEIRA" 8 "Continuous")
  (bc:camada "BOCA-OCULTO" 1 (bc:tipolinha "DASHED"))
  (bc:camada "BOCA-EIXO" 5 (bc:tipolinha "CENTER")))

(defun bc:p (q e) (list (* e (car q)) (* e (cadr q)) 0.0))

(defun bc:ent-original (en e / tp lay pts c rx ry)
  (setq tp (car en) lay (cadr en))
  (cond
    ((= tp "P")
     (setq pts (cddr en))
     (entmake (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                            '(100 . "AcDbPolyline") (cons 90 (length pts)) '(70 . 1))
                      (mapcar '(lambda (q) (list 10 (* e (car q)) (* e (cadr q)))) pts))))
    ((= tp "L")
     (entmake (list '(0 . "LINE") (cons 8 lay)
                    (cons 10 (bc:p (caddr en) e)) (cons 11 (bc:p (cadddr en) e)))))
    ((= tp "E")
     (setq c (caddr en) rx (* e (nth 3 en)) ry (* e (nth 4 en)))
     (if (equal rx ry 1e-9)
       (entmake (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 (bc:p c e)) (cons 40 rx)))
       (entmake (list '(0 . "ELLIPSE") '(100 . "AcDbEntity") (cons 8 lay)
                      '(100 . "AcDbEllipse") (cons 10 (bc:p c e)) (list 11 rx 0.0 0.0)
                      '(210 0.0 0.0 1.0) (cons 40 (/ ry rx)) '(41 . 0.0)
                      (cons 42 (* 2.0 pi))))))))

;; bloco estatico de uma variante
(defun bc:bloco-base (nome ents e / en)
  (if (not (tblsearch "BLOCK" nome))
    (progn
      (entmake (list '(0 . "BLOCK") (cons 2 nome) '(70 . 0) '(8 . "0") '(10 0.0 0.0 0.0)))
      (foreach en ents (bc:ent en e))
      (entmake '((0 . "ENDBLK") (8 . "0")))))
  nome)

;; responde prompts restantes do comando ativo; cancela se nao terminar
(defun bc:fim (resp / i)
  (setq i 0)
  (while (and (> (getvar "CMDACTIVE") 0) (< i 4))
    (command resp) (setq i (1+ i)))
  (if (> (getvar "CMDACTIVE") 0) (command)))

;; bloco dinamico com parametro de visibilidade (um estado por variante)
(defun bc:bloco-dinamico (bnome estados e / lst)
  (if (tblsearch "BLOCK" bnome)
    (prompt (strcat "\n" bnome " ja existe - ignorado."))
    (progn
      (prompt (strcat "\nCriando " bnome " ..."))
      (foreach st estados (bc:bloco-base (cadr st) (caddr st) e))
      (entmake (list '(0 . "BLOCK") (cons 2 bnome) '(70 . 0) '(8 . "0") '(10 0.0 0.0 0.0)))
      (entmake (list '(0 . "POINT") '(8 . "Defpoints") '(10 0.0 0.0 0.0)))
      (entmake '((0 . "ENDBLK") (8 . "0")))
      (command "_.-BEDIT" bnome)
      (vl-catch-all-apply 'setvar (list "BVMODE" 1))
      (setq lst '())
      (foreach st estados
        (command "_.-INSERT" (cadr st) "_non" '(0.0 0.0 0.0) "1" "1" "0")
        (bc:fim "")
        (setq lst (cons (cons (car st) (entlast)) lst)))
      (setq lst (reverse lst))
      (command "_.BPARAMETER" "_V" "_non" (list 0.0 (* e 150.0) 0.0))
      (bc:fim "1")
      (foreach it lst
        (command "_.-BVSTATE" "_N" (car it) "_H")
        (bc:fim "")
        (command "_.BVSHOW" (cdr it) "")
        (bc:fim "_C"))
      (command "_.-BVSTATE" "_S" (car (car lst)))
      (bc:fim "")
      (command "_.-BVSTATE" "_D" "VisibilityState0")
      (bc:fim "_Y")
      (vl-catch-all-apply 'setvar (list "BVMODE" 0))
      (command "_.BSAVE")
      (bc:fim "")
      (command "_.BCLOSE")
      (bc:fim "_S")
      (prompt (strcat "\n  -> " bnome " criado com " (itoa (length lst)) " estados.")))))

(defun bc:executar (modo / *error* sv e)
  (setq sv (mapcar '(lambda (v) (cons v (getvar v))) '("CMDECHO" "OSMODE" "ATTREQ")))
  (defun *error* (msg)
    (foreach v sv (vl-catch-all-apply 'setvar (list (car v) (cdr v))))
    (if (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*"))
      (prompt (strcat "\nErro: " msg
                      "\nSe o Editor de Blocos ficou aberto, feche com BCLOSE.")))
    (princ))
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ATTREQ" 0)
  (setq e (bc:esc))
  (if (= (getvar "INSUNITS") 0)
    (prompt "\nINSUNITS = 0 (sem unidade): assumindo desenho em METROS."))
  (bc:camadas)
  (cond
    ((= modo "TESTE")
     (bc:bloco-dinamico (car (car *bc:dados*)) (cadr (car *bc:dados*)) e))
    ((= modo "BASE")
     (foreach b *bc:dados*
       (foreach st (cadr b) (bc:bloco-base (cadr st) (caddr st) e)))
     (prompt "\nBlocos estaticos criados."))
    (T (foreach b *bc:dados* (bc:bloco-dinamico (car b) (cadr b) e))))
  (foreach v sv (setvar (car v) (cdr v)))
  (princ))

(defun c:BOCASTESTE () (bc:executar "TESTE"))
(defun c:BOCASDNIT () (bc:executar "TODOS"))
(defun c:BOCASBASE () (bc:executar "BASE"))

