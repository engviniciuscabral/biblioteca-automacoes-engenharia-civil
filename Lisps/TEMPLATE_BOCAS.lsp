(defun bc:falha (msg) (prompt (strcat "\n" msg)) (exit))
(defun bc:cad-estilo (/ k nm)
  (setq k (* 100.0 (bc:esc)) nm (strcat "BC_CAD_HIDDEN_" (itoa (getvar "INSUNITS"))))
  (if (not (tblsearch "LTYPE" nm))
    (if (not (entmake (list '(0 . "LTYPE") '(100 . "AcDbSymbolTableRecord")
      '(100 . "AcDbLinetypeTableRecord") (cons 2 nm) '(70 . 0)
      '(3 . "Tracejado do template cadastro") '(72 . 65) '(73 . 2)
      (cons 40 (* k 0.375)) (cons 49 (* k 0.25)) '(74 . 0)
      (cons 49 (* k -0.125)) '(74 . 0))))
      (bc:falha "Nao foi possivel criar o tipo de linha do cadastro.")))
  (bc:camada "Bocas OAC" 154 "Continuous") nm)
(defun bc:ent (en e / lt)
  (if (= (car en) "C")
    (progn (setq lt (bc:cad-estilo))
      (if (not (entmake (append
        (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "Bocas OAC")
          (cons 62 (nth 2 en)) (cons 6 (if (= (nth 2 en) 7) lt "Continuous"))
          '(48 . 0.5) '(100 . "AcDbPolyline")
          (cons 90 (length (cdddr en))) (cons 70 (cadr en)))
        (mapcar '(lambda (p) (list 10 (* e (car p)) (* e (cadr p)))) (cdddr en)))))
        (bc:falha "Falha ao criar polilinha do cadastro.")))
    (bc:ent-original en e)))
(defun bc:cad-unidades ()
  (if (not (member (getvar "INSUNITS") '(0 4 5 6)))
    (bc:falha "Use INSUNITS 6 (m), 5 (cm) ou 4 (mm)."))
  (if (= (getvar "INSUNITS") 0) (prompt "\nSem unidade: cadastro assume METROS."))
  (bc:esc))
(defun bc:cad-base (/ e st)
  (setq e (bc:cad-unidades)) (bc:cad-estilo)
  (foreach st *bc:cadastro* (bc:bloco-base (cadr st) (caddr st) e)) (princ))
(defun c:BOCASCADBASE ()
  (bc:cad-base)
  (prompt "\n18 blocos de cadastro disponiveis. Use BOCASCADASTRO para inserir.") (princ))
;;; pt e an sao relativos ao UCS; a referencia e gravada no OCS apropriado.
(defun bc:cad-inserir (nome pt an / normal vec ref)
  (setq normal (trans '(0.0 0.0 1.0) 1 0 T)
        vec (trans (list (cos an) (sin an) 0.0) 1 normal T))
  (setq ref (entmakex (list '(0 . "INSERT") '(100 . "AcDbEntity")
    '(8 . "Bocas OAC") '(100 . "AcDbBlockReference") (cons 2 nome)
    (cons 10 (trans pt 1 normal)) '(41 . 1.0) '(42 . 1.0) '(43 . 1.0)
    (cons 50 (atan (cadr vec) (car vec))) (cons 210 normal))))
  (if (null ref) (bc:falha "Falha ao inserir a boca.")) ref)
(defun c:BOCASCADASTRO (/ tp di cod pt an nome)
  (initget "BSTC BDTC BTTC")
  (setq tp (getkword "\nTipo [BSTC/BDTC/BTTC] <BSTC>: "))
  (if (null tp) (setq tp "BSTC"))
  (initget 6)
  (setq di (getreal "\nDiametro em metros [1.00/1.20/1.50/2.00/2.50/3.00] <1.00>: "))
  (if (null di) (setq di 1.0))
  (setq cod (cond ((equal di 1.0 1e-8) "100") ((equal di 1.2 1e-8) "120")
    ((equal di 1.5 1e-8) "150") ((equal di 2.0 1e-8) "200")
    ((equal di 2.5 1e-8) "250") ((equal di 3.0 1e-8) "300")))
  (if (null cod) (prompt "\nEscolha um dos seis diametros apresentados.")
    (progn (bc:cad-base)
      (setq nome (strcat "CAD_" tp cod "_V2_PL")
            pt (getpoint "\nCentro da face de chegada da boca: "))
      (if pt (progn (setq an (getangle pt "\nRotacao <0>: "))
        (if (null an) (setq an 0.0)) (bc:cad-inserir nome pt an))))) (princ))
(defun c:BOCASCADDIN ()
  (bc:bloco-dinamico "BOCA_CADASTRO_PLANTA_V2" *bc:cadastro* (bc:cad-unidades)) (princ))
;;; Integra as 18 variantes a familia BNAA em planta dos comandos originais.
(setq *bc:dados* (mapcar '(lambda (b)
  (if (= (car b) "BOCA_BNAA_PLANTA")
    (list "BOCA_BNAA_PLANTA_CAD_V2"
      (mapcar '(lambda (st / nome cad)
        (setq nome (strcat "CAD_" (substr (cadr st) 6 7) "_V2_PL")
              cad (vl-some '(lambda (item) (if (= (cadr item) nome) item)) *bc:cadastro*))
        (if cad (list (car cad) (cadr cad) (caddr cad)) st)) (cadr b))) b)) *bc:dados*))
(defun c:BOCASTESTE () (c:BOCASCADDIN))
(princ "\nCadastro v2: 18 templates. BOCASCADASTRO / BOCASCADBASE / BOCASCADDIN.")
(princ)

;;; CRIACAO DINAMICA V3 - comandos completos e verificacao do resultado.
(defun bc:dyn-validar (nome estados / doc bl rr result)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object))
        bl (vl-catch-all-apply 'vla-Item (list (vla-get-Blocks doc) nome)))
  (if (and (not (vl-catch-all-error-p bl)) (= (vla-get-IsDynamicBlock bl) :vlax-true))
    (progn
      (setq result (vl-catch-all-apply
        '(lambda (/ props p valores nomes valido)
          (setq rr (vla-InsertBlock (vla-get-ModelSpace doc)
                     (vlax-3d-point '(0.0 0.0 0.0)) nome 1.0 1.0 1.0 0.0)
                props (vlax-invoke rr 'GetDynamicBlockProperties)
                nomes (mapcar 'car estados))
          (foreach p props
            (setq valores (vl-catch-all-apply 'vlax-get (list p 'AllowedValues)))
            (if (and (listp valores) (= (length valores) (length nomes))
                     (vl-every '(lambda (n) (member n valores)) nomes))
              (setq valido T)))
          valido)))
      (if rr (vl-catch-all-apply 'vla-Delete (list rr)))
      (and (not (vl-catch-all-error-p result)) result))))
(defun bc:dyn-check (etapa)
  (if (/= (logand 1 (getvar "CMDACTIVE")) 0)
    (bc:falha (strcat "Comando pendente em " etapa "."))))
(defun bc:dyn-preservar (nome / n outro bloc)
  (setq n 1 outro (strcat nome "_INCOMPLETO_1"))
  (while (tblsearch "BLOCK" outro)
    (setq n (1+ n) outro (strcat nome "_INCOMPLETO_" (itoa n))))
  (setq bloc (vla-Item (vla-get-Blocks (vla-get-ActiveDocument (vlax-get-acad-object))) nome))
  (vla-put-Name bloc outro)
  (prompt (strcat "\nDefinicao anterior preservada como " outro ".")))
(defun bc:bloco-dinamico (bnome estados e / *error* sv etapa st refs ss it criado resultado)
  (setq sv (mapcar '(lambda (v) (cons v (getvar v)))
             '("OSMODE" "ATTREQ" "CMDECHO" "UCSFOLLOW" "CMDDIA")))
  (defun *error* (msg)
    (if (/= (logand 1 (getvar "CMDACTIVE")) 0) (command-s))
    (if (= (getvar "BLOCKEDITOR") 1)
      (vl-catch-all-apply '(lambda () (command-s "_.BCLOSE" "_Discard"))))
    (foreach v sv (vl-catch-all-apply 'setvar (list (car v) (cdr v))))
    (prompt (strcat "\nCriacao dinamica interrompida em " etapa ": " msg
      "\nNao foi confirmada uma definicao dinamica valida. Execute BOCASCADDIN para tentar novamente."))
    (princ))
  (setq etapa "verificacao inicial")
  (cond
    ((= (getvar "BLOCKEDITOR") 1)
      (prompt "\nFeche o Editor de Blocos antes de executar BOCASCADDIN."))
    ((= (getvar "BLOCKEDITLOCK") 1)
      (prompt "\nO Editor de Blocos esta bloqueado (BLOCKEDITLOCK=1)."))
    ((bc:dyn-validar bnome estados)
      (prompt (strcat "\n" bnome " ja foi validado com " (itoa (length estados)) " estados. Use INSERT.")))
    (T
      (if (tblsearch "BLOCK" bnome) (bc:dyn-preservar bnome))
      (setvar "OSMODE" 0) (setvar "ATTREQ" 0) (setvar "CMDECHO" 0)
      (setvar "UCSFOLLOW" 0) (setvar "CMDDIA" 0)
      (setq etapa "geometrias base")
      (foreach st estados (bc:bloco-base (cadr st) (caddr st) e))
      ;; A definicao inicial ja possui geometria; nunca e apenas um POINT.
      (entmake (list '(0 . "BLOCK") (cons 2 bnome) '(70 . 0) '(8 . "0") '(10 0.0 0.0 0.0)))
      (foreach st estados
        (if (not (entmake (list '(0 . "INSERT") '(8 . "0") (cons 2 (cadr st))
          '(10 0.0 0.0 0.0) '(41 . 1.0) '(42 . 1.0) '(43 . 1.0))))
          (bc:falha "Falha ao incluir geometria.")))
      (entmake '((0 . "ENDBLK") (8 . "0")))
      (setq etapa "abertura do Editor de Blocos")
      (command "_.-BEDIT" bnome) (bc:dyn-check etapa)
      (if (/= (getvar "BLOCKEDITOR") 1) (bc:falha "Editor de Blocos nao abriu."))
      (setq refs nil)
      (foreach st estados
        (setq ss (ssget "_X" (list '(0 . "INSERT") (cons 2 (cadr st)))))
        (if (or (null ss) (/= (sslength ss) 1))
          (bc:falha (strcat "Selecao incorreta de " (cadr st))))
        (setq refs (cons (cons (car st) (ssname ss 0)) refs)))
      (setq refs (reverse refs) etapa "parametro de visibilidade")
      (command "_.BPARAMETER" "_Visibility" "_non" (list 0.0 (* e 150.0) 0.0) "1")
      (bc:dyn-check etapa)
      (setvar "BVMODE" 1)
      (foreach it refs
        (setq etapa (strcat "estado " (car it)))
        (command "_.-BVSTATE" "_New" (car it) "_Hide") (bc:dyn-check etapa)
        (command "_.BVSHOW" (cdr it) "" "_Current") (bc:dyn-check etapa))
      (setq etapa "estado inicial")
      (command "_.-BVSTATE" "_Set" (caar refs)) (bc:dyn-check etapa)
      (command "_.-BVSTATE" "_Delete" "VisibilityState0") (bc:dyn-check etapa)
      (setvar "BVMODE" 0)
      (setq etapa "salvamento")
      (command "_.BSAVE") (bc:dyn-check etapa)
      (command "_.BCLOSE") (bc:dyn-check etapa)
      (setq etapa "validacao final")
      (if (not (bc:dyn-validar bnome estados))
        (bc:falha "A propriedade dinamica nao contem todos os estados esperados."))
      (prompt (strcat "\n" bnome " criado e validado com " (itoa (length estados)) " estados. Use INSERT."))))
  (foreach v sv (setvar (car v) (cdr v)))
  (princ))
(defun c:BOCASCADDIN ()
  (bc:cad-base)
  (bc:bloco-dinamico "BOCA_CADASTRO_PLANTA_V3" *bc:cadastro* (bc:cad-unidades)) (princ))
(defun c:BOCASADDIN () (c:BOCASCADDIN))
(defun c:BOCASTESTE () (c:BOCASCADDIN))
(princ "\nCadastro v3: BOCASCADDIN cria BOCA_CADASTRO_PLANTA_V3 com validacao.")
(princ)