    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\nimport math\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.AutoCAD.Geometry import Point3d, Vector3d\n\ncogos = IN[0]\ndata = IN[1]\n\ndeslocamento_label = 0.0\r\ndeslocamento_ao_longo = -18.0\r\nrotacao_extra_graus = 90.0\r\nmanter_texto_legivel = True\n\ndef as_list(value):\n    if value is None:\n        return []\n    if isinstance(value, list):\n        return value\n    try:\n        return list(value)\n    except:\n        return [value]\n\ndef get_object_id(obj):\n    if obj is None:\n        return None\n\n    for attr in [\"InternalDBObject\", \"InternalObject\", \"InternalDBObjectId\", \"InternalObjectId\", \"ObjectId\"]:\n        try:\n            v = getattr(obj, attr)\n            if callable(v):\n                v = v()\n            if v is None:\n                continue\n            try:\n                if hasattr(v, \"ObjectId\"):\n                    return v.ObjectId\n            except:\n                pass\n            try:\n                # ObjectId usually has IsNull.\n                if hasattr(v, \"IsNull\"):\n                    return v\n            except:\n                pass\n        except:\n            pass\n\n    return None\n\ndef try_set_label(cogo, label_pt, offset_vec, angle):\n    moved = False\n    rotated = False\n\n    try:\n        cogo.IsLabelDragged = True\n    except:\n        pass\n\n    for prop, val in [\n        (\"LabelLocation\", label_pt),\n        (\"LabelPosition\", label_pt),\n        (\"LabelDraggedOffset\", offset_vec),\n        (\"DraggedLabelOffset\", offset_vec),\n        (\"LabelOffset\", offset_vec)\n    ]:\n        try:\n            setattr(cogo, prop, val)\n            moved = True\n            break\n        except:\n            pass\n\n    for method, val in [\n        (\"SetLabelLocation\", label_pt),\n        (\"SetLabelPosition\", label_pt),\n        (\"SetLabelDraggedOffset\", offset_vec)\n    ]:\n        if moved:\n            break\n        try:\n            getattr(cogo, method)(val)\n            moved = True\n            break\n        except:\n            pass\n\n    for prop in [\"LabelRotation\", \"Rotation\", \"LabelTextRotation\"]:\n        try:\n            setattr(cogo, prop, angle)\n            rotated = True\n            break\n        except:\n            pass\n\n    for method in [\"SetLabelRotation\", \"SetRotation\"]:\n        if rotated:\n            break\n        try:\n            getattr(cogo, method)(angle)\n            rotated = True\n            break\n        except:\n            pass\n\n    return moved, rotated\n\ncogo_list = as_list(cogos)\npts = as_list(data[0]) if len(data) > 0 else []\nangles = as_list(data[5]) if len(data) > 5 else []\nnomes = as_list(data[1]) if len(data) > 1 else []\n\nacad_doc = Application.DocumentManager.MdiActiveDocument\navisos = []\najustados = 0\n\nif acad_doc is None:\n    OUT = \"Documento AutoCAD ativo nao encontrado.\"\nelse:\n    lock = acad_doc.LockDocument()\n    tr = acad_doc.Database.TransactionManager.StartTransaction()\n    try:\n        total = min(len(cogo_list), len(pts), len(angles))\n        for i in range(total):\n            oid = get_object_id(cogo_list[i])\n            if oid is None:\n                avisos.append(\"Sem ObjectId para item {}\".format(i + 1))\n                continue\n\n            cogo = tr.GetObject(oid, OpenMode.ForWrite)\n            x = pts[i].X\n            y = pts[i].Y\n            angle_base = angles[i]\n            angle = angle_base + math.radians(rotacao_extra_graus)\n\n            # Espelha a leitura quando a rotacao cair de cabeca para baixo.\n            if manter_texto_legivel:\n                angle_norm = angle % (2.0 * math.pi)\n                if angle_norm > (math.pi / 2.0) and angle_norm < (3.0 * math.pi / 2.0):\n                    angle = angle + math.pi\n\n            # Primeiro afasta perpendicularmente ao alinhamento.\n            dx = math.cos(angle_base) * deslocamento_label\n            dy = math.sin(angle_base) * deslocamento_label\n\n            # Depois afasta tambem na direcao do alinhamento, para tirar a label do miolo.\n            angle_alinhamento = angle_base - (math.pi / 2.0)\n            dx += math.cos(angle_alinhamento) * deslocamento_ao_longo\n            dy += math.sin(angle_alinhamento) * deslocamento_ao_longo\n            label_pt = Point3d(x + dx, y + dy, 0)\n            offset_vec = Vector3d(dx, dy, 0)\n\n            if i < len(nomes):\n                for prop in [\"Name\", \"PointName\"]:\n                    try:\n                        setattr(cogo, prop, nomes[i])\n                        break\n                    except:\n                        pass\n                try:\n                    cogo.RawDescription = nomes[i]\n                except:\n                    pass\n\n            moved, rotated = try_set_label(cogo, label_pt, offset_vec, angle)\n            if moved or rotated:\n                ajustados += 1\n            if not moved:\n                avisos.append(\"{}: label nao moveu\".format(i + 1))\n            if not rotated:\n                avisos.append(\"{}: label nao girou\".format(i + 1))\n\n        tr.Commit()\n        OUT = \"Labels ajustadas em {} de {} COGO Points. Rotacao extra: {} graus anti-horario; leitura espelhada: {}. {}\".format(ajustados, total, rotacao_extra_graus, manter_texto_legivel, \" | \".join(avisos[:8]))\n    except Exception as ex:\n        OUT = \"Erro ao ajustar labels: {}\".format(ex)\n    finally:\n        tr.Dispose()\n        lock.Dispose()",
