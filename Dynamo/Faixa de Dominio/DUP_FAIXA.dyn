      "Replication": "Disabled",
      "Description": "Creates a number."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\nimport math\n\nclr.AddReference('ProtoGeometry')\nfrom Autodesk.DesignScript.Geometry import Point, Vector, CoordinateSystem\n\n# Civil 3D / AutoCAD API. Esta rotina evita os nos AlignmentByName e\n# Alignment.Stations do Dynamo, que podem falhar em alinhamentos copiados.\ntry:\n    clr.AddReference('AcMgd')\n    clr.AddReference('AcDbMgd')\n    clr.AddReference('AeccDbMgd')\nexcept:\n    pass\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\n\nprefixo = IN[0]\ninicio = int(IN[1])\nfim = int(IN[2])\nmodo = IN[3]\n\nif prefixo is None:\n    prefixo = 'AL'\nprefixo = str(prefixo).strip()\n\nif modo is None:\n    modo = 'TODOS'\nmodo = str(modo).strip().upper()\nif modo in ['IMPAR', 'IMPARES', '?MPAR', '?MPARES']:\n    filtro = 'IMPARES'\nelif modo in ['PAR', 'PARES']:\n    filtro = 'PARES'\nelse:\n    filtro = 'TODOS'\n\nnumero_inicial = 2\ntol = 0.01\n\npts=[]\nnomes=[]\ndescricoes=[]\nstations_filtradas_total=[]\ncoordinate_systems=[]\nangulos_perp_rad=[]\nangulos_perp_graus=[]\ncoords_ne=[]\norigem_alinhamento=[]\navisos=[]\nindices_ultimo_alinhamento=[]\n\n\ndef normalizar_nome(s):\n    return str(s).strip().upper()\n\n\ndef nomes_desejados():\n    wanted=[]\n    step = 1 if inicio <= fim else -1\n    n = inicio\n    while (step > 0 and n <= fim) or (step < 0 and n >= fim):\n        incluir = False\n        if filtro == 'TODOS':\n            incluir = True\n        elif filtro == 'PARES' and n % 2 == 0:\n            incluir = True\n        elif filtro == 'IMPARES' and abs(n % 2) == 1:\n            incluir = True\n        if incluir:\n            wanted.append('{} {}'.format(prefixo, n))\n        n += step\n    return wanted\n\n\ndef get_numeric(obj, names):\n    for name in names:\n        try:\n            v = getattr(obj, name)\n            if callable(v):\n                v = v()\n            if v is not None:\n                return float(v)\n        except:\n            pass\n    return None\n\n\ndef add_unique(vals, v):\n    if v is None:\n        return\n    try:\n        v = float(v)\n    except:\n        return\n    for e in vals:\n        if abs(e - v) <= tol:\n            return\n    vals.append(v)\n\n\ndef alignment_stations(al):\n    vals=[]\n    add_unique(vals, get_numeric(al, ['StartingStation','StartStation','StationStart','BeginStation']))\n    add_unique(vals, get_numeric(al, ['EndingStation','EndStation','StationEnd','FinishStation']))\n\n    # Tenta pegar inicios/fins das entidades internas do alinhamento.\n    try:\n        ents = al.Entities\n        for ent in ents:\n            add_unique(vals, get_numeric(ent, ['StartingStation','StartStation','StationStart','BeginStation']))\n            add_unique(vals, get_numeric(ent, ['EndingStation','EndStation','StationEnd','FinishStation']))\n    except Exception as e:\n        pass\n\n    vals.sort()\n    return vals\n\n\ndef point_location(al, sta, off):\n    # Civil 3D .NET usa out/ref para easting/northing. Testa assinaturas comuns.\n    try:\n        e = clr.Reference[float](0.0)\n        n = clr.Reference[float](0.0)\n        al.PointLocation(float(sta), float(off), e, n)\n        return float(e.Value), float(n.Value)\n    except:\n        pass\n    try:\n        e = clr.Reference[float](0.0)\n        n = clr.Reference[float](0.0)\n        bearing = clr.Reference[float](0.0)\n        al.PointLocation(float(sta), float(off), e, n, bearing)\n        return float(e.Value), float(n.Value)\n    except Exception as ex:\n        avisos.append('PointLocation falhou na estaca {}: {}'.format(sta, ex))\n        return None\n\n\ndef tangent_angle(al, sta):\n    # Aproxima tangente por diferenca pequena ao longo da estaca.\n    delta = 0.10\n    p0 = point_location(al, sta, 0.0)\n    p1 = point_location(al, sta + delta, 0.0)\n    if p1 is None:\n        p1 = point_location(al, sta - delta, 0.0)\n        if p1 is not None and p0 is not None:\n            return math.atan2(p0[1]-p1[1], p0[0]-p1[0])\n    if p0 is not None and p1 is not None:\n        return math.atan2(p1[1]-p0[1], p1[0]-p0[0])\n    return 0.0\n\n\ndef adicionar_ponto(al, sta, indice_alinhamento, ultimo_indice):\n    loc = point_location(al, sta, 0.0)\n    if loc is None:\n        return False\n    x, y = loc\n    ang = tangent_angle(al, sta)\n    vx = Vector.ByCoordinates(math.cos(ang), math.sin(ang), 0)\n    vy = Vector.ByCoordinates(-math.sin(ang), math.cos(ang), 0)\n    cs = CoordinateSystem.ByOriginVectors(Point.ByCoordinates(x, y, 0), vx, vy)\n\n    numero = len(nomes) + numero_inicial\n    pts.append(Point.ByCoordinates(x, y, 0))\n    coordinate_systems.append(cs)\n    stations_filtradas_total.append(sta)\n    origem_alinhamento.append(indice_alinhamento)\n    if indice_alinhamento == ultimo_indice:\n        indices_ultimo_alinhamento.append(len(nomes))\n\n    angle_base = ang\n    angulos_perp_rad.append(angle_base)\n    angulos_perp_graus.append(math.degrees(angle_base))\n    nomes.append('Ponto {}'.format(numero))\n    descricoes.append('Ponto {}'.format(numero))\n    coords_ne.append([y, x])\n    return True\n\n\ndef processar():\n    doc = Application.DocumentManager.MdiActiveDocument\n    db = doc.Database\n    civdoc = CivilApplication.ActiveDocument\n    wanted = nomes_desejados()\n    wanted_norm = dict((normalizar_nome(n), n) for n in wanted)\n\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        found = {}\n        ids = civdoc.GetAlignmentIds()\n        for oid in ids:\n            try:\n                al = tr.GetObject(oid, OpenMode.ForRead)\n                nm = normalizar_nome(al.Name)\n                if nm in wanted_norm:\n                    found[nm] = al\n            except Exception as e:\n                pass\n\n        ultimo_indice = len(wanted)\n        for idx, nm_original in enumerate(wanted):\n            nm = normalizar_nome(nm_original)\n            al = found.get(nm)\n            if al is None:\n                avisos.append('Nao encontrou alinhamento: {}'.format(nm_original))\n                continue\n            stas = alignment_stations(al)\n            if len(stas) == 0:\n                avisos.append('Alinhamento sem estacas legiveis: {}'.format(nm_original))\n                continue\n            criou = 0\n            for sta in stas:\n                if adicionar_ponto(al, sta, idx + 1, ultimo_indice):\n                    criou += 1\n            if criou == 0:\n                avisos.append('Encontrou {}, mas nao criou pontos.'.format(nm_original))\n        tr.Commit()\n    except Exception as e:\n        avisos.append('Erro geral API Civil: {}'.format(e))\n        try:\n            tr.Abort()\n        except:\n            pass\n\nprocessar()\n\nif len(indices_ultimo_alinhamento) > 0:\n    idx_ultimo = indices_ultimo_alinhamento[-1]\n    nomes[idx_ultimo] = 'Ponto 1'\n    descricoes[idx_ultimo] = 'Ponto 1'\n\nOUT=[pts, nomes, descricoes, stations_filtradas_total, coordinate_systems, angulos_perp_rad, angulos_perp_graus, coords_ne, origem_alinhamento, avisos]\n",
      "VariableInputPorts": true,
      "Id": "8afe11f85a9f411f8dbb74d3abe04e09",
