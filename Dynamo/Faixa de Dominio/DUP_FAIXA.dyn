    {
      "ConcreteType": "CoreNodeModels.Input.DoubleInput, CoreNodeModels",
      "NodeType": "NumberInputNode",
      "NumberType": "Double",
      "InputValue": 1000000.0,
      "Id": "fdef62ffa76944b98ddbab6d0a97eab3",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "586783c9ada84036b0123f8e55c4672d",
          "Name": "",
          "Description": "Double",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
