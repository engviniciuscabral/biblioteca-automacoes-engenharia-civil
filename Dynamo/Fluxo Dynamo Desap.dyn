      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point\r\n\r\nalignment = IN[0]\r\nstations = IN[1]\r\n\r\ntol = 0.01\r\n\r\n# Filtragem\r\nstations_filtradas = []\r\n\r\nfor i in range(len(stations)):\r\n\r\n    if i == 0 or i == len(stations)-1:\r\n        stations_filtradas.append(stations[i])\r\n        continue\r\n\r\n    prev_sta = stations[i-1]\r\n    curr_sta = stations[i]\r\n    next_sta = stations[i+1]\r\n\r\n    midpoint = (prev_sta + next_sta)/2.0\r\n\r\n    if abs(curr_sta - midpoint) > tol:\r\n        stations_filtradas.append(curr_sta)\r\n\r\n# Geração dos dados\r\npts = []\r\nnomes = []\r\ndescricoes = []\r\n\r\nfor i, sta in enumerate(stations_filtradas):\r\n\r\n    cs = alignment.CoordinateSystemByStationOffset(sta,0)\r\n\r\n    pts.append(\r\n        Point.ByCoordinates(\r\n            cs.Origin.X,\r\n            cs.Origin.Y,\r\n            0\r\n        )\r\n    )\r\n\r\n    nomes.append(\"P{}\".format(i+2))\r\n\r\n    descricoes.append(\"Ponto {}\".format(i+2))\r\n\r\nOUT = [pts, nomes, descricoes]",
      "VariableInputPorts": true,
